# drs_deploy.conf.example
# 自动化部署 DRS(数据复制软件)高可用集群
#
# 用法:复制本文件为 drs_deploy.conf,把 CHANGE_ME 替换成实际值,然后:
#   python3 drs_deploy.py drs_deploy.conf --check-conf   # 先校验
#   python3 drs_deploy.py drs_deploy.conf                # 全流程部署
#
# 格式约定:
#   - 扁平 key = "value"(字符串带引号;数字/布尔不带)
#   - "#" 行内注释(空格 + # 后面的内容)
#   - 不读取任何环境变量,所有入参走 conf


# ============================================================
# === 部署总览 ===
# ============================================================

# deploy_scene:部署场景
#   ha          : 高可用(3 节点 GaussDB + 2 节点 DRS-Service + ≥2 节点 DRS-Node)
#   independent: 单节点(只填 drs_service_primary_ip,standby_ip 留空)
deploy_scene = "ha"

# cluster_name:本集群标识,仅用于日志(不影响实际部署)
cluster_name = "drs-cluster-01"


# ============================================================
# === SSH 通道(必须先在控制节点与目标节点之间配好互信)===
# ============================================================

# 推荐做法:在控制节点 ssh-keygen,把 id_rsa.pub 追加到所有目标节点的 ~/.ssh/authorized_keys
# 若不配 ssh_key,本脚本每次 ssh 都会卡密码提示 — 不推荐

ssh_user = "root"
ssh_port = 22
ssh_key = "/root/.ssh/id_rsa"   # 控制节点的私钥路径


# ============================================================
# === 元数据库 GaussDB(高可用 = 3 节点集中式 HA)===
# 高可用架构要求:
#   - 3 台物理机,管理 IP 在同一子网可互通
#   - 每台 ≥24 核 CPU、≥144 GB 内存、≥1824 GB 磁盘
#   - 已完成磁盘分区:/  100G(ext4)、/data/cluster ≥1024G(ext4)
# ============================================================

# GaussDB 节点管理 IP(必填,3 个都不能少)
gaussdb_node1_ip = "10.0.0.1"
gaussdb_node2_ip = "10.0.0.2"
gaussdb_node3_ip = "10.0.0.3"

# 节点拓扑信息 — 用于 install_cluster.json 的 clusterConf.cm
# 单网卡场景:data_ip / virtual_ip 与管理 IP 一致即可
gaussdb_node1_az = "AZ1"
gaussdb_node1_rack = "rack1"
gaussdb_node1_data_ip = "10.0.0.1"
gaussdb_node1_virtual_ip = "10.0.0.1"

gaussdb_node2_az = "AZ2"
gaussdb_node2_rack = "rack2"
gaussdb_node2_data_ip = "10.0.0.2"
gaussdb_node2_virtual_ip = "10.0.0.2"

gaussdb_node3_az = "AZ3"
gaussdb_node3_rack = "rack3"
gaussdb_node3_data_ip = "10.0.0.3"
gaussdb_node3_virtual_ip = "10.0.0.3"

# GaussDB 安装用户(用于 install_cluster.conf 的 os_user)
#   - 用户名由 1-32 个字符组成,可包含英文字母、数字、下划线
#   - 区分大小写,且不能是纯数字,不能是 root 和 Ruby
gaussdb_os_user = "omm"
gaussdb_os_user_group = "dbgrp"
gaussdb_os_user_password = "CHANGE_ME_omm_pwd"   # 至少 4 种类别,长度 8-15
gaussdb_root_password = "CHANGE_ME_root_pwd"     # 3 节点 root 密码必须一致

# GaussDB 库账号密码(用于 install_cluster.json)
#   - 安装完成后这些密码会被 install.sh 清空,务必妥善保管
gaussdb_db_port = 30100
gaussdb_rdsAdminPasswd = "CHANGE_ME_rdsAdmin"
gaussdb_rdsMetricPasswd = "CHANGE_ME_rdsMetric"
gaussdb_rdsReplPasswd = "CHANGE_ME_rdsRepl"
gaussdb_rdsBackupPasswd = "CHANGE_ME_rdsBackup"
# 关键:这个密码同时是 DRS-Service 安装时 metaDB_root_password
gaussdb_dbUserPasswd = "CHANGE_ME_dbUserPasswd"

# GaussDB 安装目录(可选,不填用默认)
gaussdb_data_dir = "/data/cluster"
gaussdb_home = "/opt/gaussdb/app"


# ============================================================
# === DRS-Service(高可用 = primary + standby,装在 GaussDB 节点上)===
# HA 场景:primary 装在 gaussdb_node1,standby 装在 gaussdb_node2(推荐)
# independent 场景:只填 primary,standby 留空
# ============================================================

drs_service_primary_ip = "10.0.0.1"   # 与 gaussdb_node1_ip 一致
drs_service_standby_ip = "10.0.0.2"   # 与 gaussdb_node2_ip 一致(HA 必填,independent 留空)
drs_service_external_port = 7443
drs_service_admin_user = "admin"
drs_service_admin_password = "CHANGE_ME_drs_admin"   # 大小写+数字+特殊,≥8 位

# use_cgroup:是否使用 cgroup 限制 CPU/内存
#   yes:轻量化单 DC 标准场景,DRS 管理面与 TPOPS 共三机 HA 部署时使用
#   no :其余场景
drs_service_use_cgroup = "no"

# is_rebuild:是否重装备节点(仅当备节点机器损坏且无法修复时用,默认 no)
drs_service_is_rebuild = "no"


# ============================================================
# === DRS-Node(≥2 节点,与 GaussDB/Service 异机,可横向扩展)===
# 节点规格参考:CPU ≥16 核、内存 ≥32 GB、磁盘 ≥500 GB
# 磁盘分区:/ 100G、/drs 100G、/data ≥100G
# ============================================================

# 逗号分隔,至少 1 个 IP(空 = 不安装 DRS-Node)
drs_node_ips = "10.0.0.10,10.0.0.11"
drs_node_swap_space = "2G"


# ============================================================
# === 软件包 ===
# 把以下 5 个 tar 全部放到 package_dir 目录下,脚本按文件名 glob 自动匹配:
#   GaussDBInstaller_*.tar.gz
#   DBS-MetaDB_*_Centralized_*.tar.gz
#   DRS-Service-*.tar.gz
#   DRS-Node-*.tar.gz
#   Monitor-Agent-*.tar.gz
#
# 同名包只能放一个版本(否则脚本拒绝,列出全部候选)
# DBS-MetaDB 同 OS 只能放一个(Kylin / Bclinux / UnionTech 三选一)
# ============================================================

package_dir = "/root/package"


# ============================================================
# === 验证 ===
# ============================================================

# verify_skip:true 跳过最后的 TCP 端口探测(默认 false)
verify_skip = "false"